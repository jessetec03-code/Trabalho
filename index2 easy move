    </div>
  </header>

  <!-- ==========================================================================
       CONTEÚDO PRINCIPAL DA PÁGINA
       ========================================================================== -->
  <main id="conteudo-principal">

    <!-- ========================================================================
         3. HERO SECTION
         Título forte, acolhedor, subtítulo claro, CTAs e imagem de idoso ativo
         ======================================================================== -->
    <section id="inicio" class="hero-secao" aria-labelledby="titulo-hero">
      <div class="conteiner hero-grid">
        
        <div class="hero-conteudo">
          <span class="tag-secao">Bem-vindo(a) ao Easy Move</span>
          <h1 id="titulo-hero" class="hero-titulo">
            Mais equilíbrio, mais força e mais autonomia no seu dia a dia
          </h1>
          <p class="hero-subtitulo">
            Exercícios físicos seguros, suaves e personalizados para você viver com mais disposição, prevenir quedas e ter total liberdade para aproveitar cada momento.
          </p>

          <div class="hero-acoes">
            <a href="#agendar" class="btn btn-principal">Agendar minha avaliação</a>
            <a href="#como-funciona" class="btn btn-secundario">Saber mais</a>
          </div>

          <!-- Destaques rápidos de segurança -->
          <div class="hero-vantagens-rapidas">
            <div class="item-vantagem-rapida">
              <span class="icone-checado" aria-hidden="true">✓</span>
              <span>Avaliação individual prévia</span>
            </div>
            <div class="item-vantagem-rapida">
              <span class="icone-checado" aria-hidden="true">✓</span>
              <span>Acompanhamento profissional</span>
            </div>
            <div class="item-vantagem-rapida">
              <span class="icone-checado" aria-hidden="true">✓</span>
              <span>No seu próprio ritmo</span>
            </div>
          </div>
        </div>

