  <!-- ==========================================================================
       JAVASCRIPT PURO: ACESSIBILIDADE, ACCORDION, MENU MOBILE E FORMULÁRIO
       ========================================================================== -->
  <script>
    /* Executa após o carregamento seguro do DOM */
    document.addEventListener('DOMContentLoaded', () => {

      /* ------------------------------------------------------------------------
         1. CONTROLE DE TAMANHO DE FONTE (A+, A-, A NORMAL)
         ------------------------------------------------------------------------ */
      const btnAumentar = document.getElementById('btn-aumentar-fonte');
      const btnDiminuir = document.getElementById('btn-diminuir-fonte');
      const btnRedefinir = document.getElementById('btn-redefinir-fonte');
      const regiaoStatus = document.getElementById('status-acessibilidade');

      // Limites acessíveis de tamanho de fonte em pixels
      const FONTE_PADRAO = 20;
      const FONTE_MINIMA = 18;
      const FONTE_MAXIMA = 26;
      const PASSO = 2;

      // Recupera preferência gravada ou usa o padrão 20px
      let tamanhoAtual = parseInt(localStorage.getItem('easymove_tamanho_fonte')) || FONTE_PADRAO;

      function aplicarTamanhoFonte(novoTamanho, anunciar = true) {
        tamanhoAtual = novoTamanho;
        document.documentElement.style.fontSize = `${tamanhoAtual}px`;
        localStorage.setItem('easymove_tamanho_fonte', tamanhoAtual);

        if (anunciar && regiaoStatus) {
          regiaoStatus.textContent = `Tamanho da fonte ajustado para ${tamanhoAtual} pixels.`;
        }
      }

      // Aplica tamanho inicial salvo
      aplicarTamanhoFonte(tamanhoAtual, false);

      btnAumentar.addEventListener('click', () => {
        if (tamanhoAtual < FONTE_MAXIMA) {
          aplicarTamanhoFonte(tamanhoAtual + PASSO);
        } else if (regiaoStatus) {
          regiaoStatus.textContent = 'Tamanho máximo de fonte atingido.';
        }
      });

      btnDiminuir.addEventListener('click', () => {
        if (tamanhoAtual > FONTE_MINIMA) {
          aplicarTamanhoFonte(tamanhoAtual - PASSO);
        } else if (regiaoStatus) {
          regiaoStatus.textContent = 'Tamanho mínimo de fonte atingido.';
        }
      });

      btnRedefinir.addEventListener('click', () => {
        aplicarTamanhoFonte(FONTE_PADRAO);
        if (regiaoStatus) {
          regiaoStatus.textContent = 'Tamanho da fonte redefinido para o padrão de 20 pixels.';
        }
      });

      /* ------------------------------------------------------------------------
         2. MODO ALTO CONTRASTE (FUNDO PRETO, TEXTO BRANCO E BOTÕES EM ALTO CONTRASTE)
         ------------------------------------------------------------------------ */
      const btnAltoContraste = document.getElementById('btn-alto-contraste');
      const textoContraste = document.getElementById('texto-contraste');

      const salvoContraste = localStorage.getItem('easymove_alto_contraste') === 'true';

      function definirAltoContraste(ativar, anunciar = true) {
        if (ativar) {
          document.body.classList.add('alto-contraste');
          btnAltoContraste.setAttribute('aria-pressed', 'true');
          textoContraste.textContent = 'Contraste Normal';
          localStorage.setItem('easymove_alto_contraste', 'true');
          if (anunciar && regiaoStatus) {
            regiaoStatus.textContent = 'Modo de alto contraste ativado: fundo escuro e texto claro.';
          }
        } else {
          document.body.classList.remove('alto-contraste');
          btnAltoContraste.setAttribute('aria-pressed', 'false');
          textoContraste.textContent = 'Alto Contraste';
          localStorage.setItem('easymove_alto_contraste', 'false');
          if (anunciar && regiaoStatus) {
            regiaoStatus.textContent = 'Modo de alto contraste desativado: cores normais restauradas.';
          }
        }
      }

      // Inicializa estado do alto contraste
      definirAltoContraste(salvoContraste, false);

      btnAltoContraste.addEventListener('click', () => {
        const ativo = document.body.classList.contains('alto-contraste');
        definirAltoContraste(!ativo);
      });

      /* ------------------------------------------------------------------------
         3. MENU MOBILE RESPONSIVO COM RÓTULO VISÍVEL
         ------------------------------------------------------------------------ */
      const btnMenuMobile = document.getElementById('btn-menu-mobile');
      const menuPrincipal = document.getElementById('menu-principal');
      const linksMenu = menuPrincipal.querySelectorAll('a');

      function alternarMenuMobile() {
        const aberto = menuPrincipal.classList.toggle('aberta');
        btnMenuMobile.setAttribute('aria-expanded', aberto ? 'true' : 'false');
        btnMenuMobile.setAttribute('aria-label', aberto ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
      }

      btnMenuMobile.addEventListener('click', alternarMenuMobile);

      // Fecha o menu ao clicar em qualquer link (facilita navegação em telas pequenas)
      linksMenu.forEach(link => {
        link.addEventListener('click', () => {
          if (menuPrincipal.classList.contains('aberta')) {
            alternarMenuMobile();
          }
        });
      });

      /* ------------------------------------------------------------------------
         4. ACCORDION ACESSÍVEL (PERGUNTAS FREQUENTES COM ARIA E TECLADO)
         ------------------------------------------------------------------------ */
      const botoesFaq = document.querySelectorAll('.faq-pergunta-btn');

      botoesFaq.forEach(botao => {
        botao.addEventListener('click', () => {
          const idResposta = botao.getAttribute('aria-controls');
          const resposta = document.getElementById(idResposta);
          const estaExpandido = botao.getAttribute('aria-expanded') === 'true';

          // Alterna estado atual
          botao.setAttribute('aria-expanded', !estaExpandido);
          if (estaExpandido) {
            resposta.hidden = true;
          } else {
            resposta.hidden = false;
          }
        });
      });

      /* ------------------------------------------------------------------------
         5. FORMULÁRIO DE AGENDAMENTO (VALIDAÇÃO E CONFIRMAÇÃO VISUAL)
         ------------------------------------------------------------------------ */
      const formAgendamento = document.getElementById('form-agendamento');
      const msgSucesso = document.getElementById('mensagem-sucesso');
      const campoNome = document.getElementById('campo-nome');
      const campoTelefone = document.getElementById('campo-telefone');

      formAgendamento.addEventListener('submit', (evento) => {
        evento.preventDefault();

        // Validação simples
        if (!campoNome.value.trim()) {
          alert('Por favor, informe seu nome completo.');
          campoNome.focus();
          return;
        }

        if (!campoTelefone.value.trim() || campoTelefone.value.trim().length < 8) {
          alert('Por favor, informe um número de telefone com DDD válido para entrarmos em contato.');
          campoTelefone.focus();
          return;
        }

        // Exibe mensagem de confirmação acessível
        msgSucesso.style.display = 'block';
        if (regiaoStatus) {
          regiaoStatus.textContent = 'Pedido de agendamento enviado com sucesso! Nossa equipe entrará em contato em breve.';
        }

        // Limpa os campos
        formAgendamento.reset();

        // Rola suavemente até a mensagem de confirmação
        msgSucesso.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

    });
  </script>
