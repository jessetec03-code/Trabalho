  <!-- ==========================================================================
       2. CABEÇALHO PRINCIPAL
       Logotipo, Menu com rótulo 'Menu' visível no mobile e botão 'Quero começar'
       ========================================================================== -->
  <header class="cabecalho-principal" role="banner">
    <div class="conteiner cabecalho-conteudo">
      
      <!-- Logotipo Easy Move -->
      <a href="#inicio" class="logo-link" aria-label="Easy Move - Página inicial">
