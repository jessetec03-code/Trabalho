        <div class="icone-menu-barras" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <span>Menu</span>
      </button>

      <!-- Menu de Navegação -->
      <nav id="menu-navegacao-principal" class="menu-navegacao" aria-label="Navegação do site">
