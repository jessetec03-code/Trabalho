  <!-- ==========================================================================
       SCRIPTS JAVASCRIPT PURO
       - Ajuste acessível de tamanho de fonte (A+, A-, normal)
       - Alternância de Modo Alto Contraste (com persistência no localStorage)
       - Menu Mobile com rótulo 'Menu' e acessibilidade por teclado
       - Accordion acessível com suporte à tecla Enter/Espaço e ARIA states
       - Anúncios dinâmicos para leitores de tela
       ========================================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      'use strict';

      // Elemento para anúncio de leitores de tela
      var statusLeitorTela = document.getElementById('status-leitor-tela');

      function avisarLeitorTela(mensagem) {
        if (statusLeitorTela) {
          statusLeitorTela.textContent = '';
          // Pequeno timeout para garantir que leitores de tela registrem a mudança
          setTimeout(function () {
            statusLeitorTela.textContent = mensagem;
          }, 60);
        }
      }

      /* ======================================================================
         1. AJUSTE DE TAMANHO DE FONTE (A+, A-, RESTAURAR)
         Permite aumentar ou diminuir a escala tipográfica da página
         ====================================================================== */
      var fatorFonteAtual = 1;
      var FATOR_MIN = 0.9;
      var FATOR_MAX = 1.35;
      var PASSO = 0.1;

      // Recuperar preferência salva no navegador
      try {
        var fonteSalva = localStorage.getItem('easyMove_fatorFonte');
        if (fonteSalva) {
          fatorFonteAtual = parseFloat(fonteSalva);
          aplicarFatorFonte(fatorFonteAtual, false);
        }
      } catch (e) {
        console.warn('Não foi possível ler o localStorage:', e);
      }

      function aplicarFatorFonte(fator, notificar) {
        // Limitar dentro dos limites mínimo e máximo
        fatorFonteAtual = Math.min(Math.max(fator, FATOR_MIN), FATOR_MAX);
        document.documentElement.style.setProperty('--fator-fonte', fatorFonteAtual);

        try {
          localStorage.setItem('easyMove_fatorFonte', fatorFonteAtual.toString());
        } catch (e) {}

        if (notificar) {
          var porcentagem = Math.round(fatorFonteAtual * 100);
          avisarLeitorTela('Tamanho do texto ajustado para ' + porcentagem + ' por cento');
        }
      }

      var btnAumentar = document.getElementById('btn-aumentar-fonte');
      var btnDiminuir = document.getElementById('btn-diminuir-fonte');
      var btnResetar = document.getElementById('btn-resetar-fonte');

      if (btnAumentar) {
        btnAumentar.addEventListener('click', function () {
          aplicarFatorFonte(fatorFonteAtual + PASSO, true);
        });
      }

      if (btnDiminuir) {
        btnDiminuir.addEventListener('click', function () {
          aplicarFatorFonte(fatorFonteAtual - PASSO, true);
        });
      }

      if (btnResetar) {
        btnResetar.addEventListener('click', function () {
          aplicarFatorFonte(1, true);
        });
      }

      /* ======================================================================
         2. MODO ALTO CONTRASTE
         Fundo #0D0D0D, texto branco e botões brancos com texto preto
         ====================================================================== */
      var btnAltoContraste = document.getElementById('btn-alto-contraste');
      var textoBtnContraste = document.getElementById('texto-btn-contraste');

      function definirAltoContraste(ativo, notificar) {
        if (ativo) {
          document.documentElement.classList.add('alto-contraste');
          btnAltoContraste.setAttribute('aria-pressed', 'true');
          if (textoBtnContraste) textoBtnContraste.textContent = 'Contraste Normal';
          if (notificar) avisarLeitorTela('Modo de alto contraste ativado');
        } else {
          document.documentElement.classList.remove('alto-contraste');
          btnAltoContraste.setAttribute('aria-pressed', 'false');
          if (textoBtnContraste) textoBtnContraste.textContent = 'Alto Contraste';
          if (notificar) avisarLeitorTela('Modo de contraste padrão restaurado');
        }

        try {
          localStorage.setItem('easyMove_altoContraste', ativo ? 'true' : 'false');
        } catch (e) {}
      }

      // Recuperar estado de alto contraste salvo
      try {
        var contrasteSalvo = localStorage.getItem('easyMove_altoContraste');
        if (contrasteSalvo === 'true') {
          definirAltoContraste(true, false);
        }
      } catch (e) {}

      if (btnAltoContraste) {
        btnAltoContraste.addEventListener('click', function () {
          var estaAtivo = document.documentElement.classList.contains('alto-contraste');
          definirAltoContraste(!estaAtivo, true);
        });
      }

      /* ======================================================================
         3. MENU MOBILE COM RÓTULO VISÍVEL 'MENU'
         Suporte para abrir/fechar, tecla Esc e fechar ao clicar em item
         ====================================================================== */
      var btnMenuMobile = document.getElementById('btn-menu-mobile');
      var menuNavegacao = document.getElementById('menu-navegacao-principal');

      if (btnMenuMobile && menuNavegacao) {
        function fecharMenuMobile() {
          menuNavegacao.classList.remove('menu-aberto');
          btnMenuMobile.setAttribute('aria-expanded', 'false');
          btnMenuMobile.setAttribute('aria-label', 'Abrir menu de navegação');
        }

        function abrirMenuMobile() {
          menuNavegacao.classList.add('menu-aberto');
          btnMenuMobile.setAttribute('aria-expanded', 'true');
          btnMenuMobile.setAttribute('aria-label', 'Fechar menu de navegação');
          avisarLeitorTela('Menu de navegação aberto');
        }

        btnMenuMobile.addEventListener('click', function () {
          var aberto = menuNavegacao.classList.contains('menu-aberto');
          if (aberto) {
            fecharMenuMobile();
          } else {
            abrirMenuMobile();
          }
        });

        // Fechar ao pressionar a tecla Escape
        document.addEventListener('keydown', function (evento) {
          if (evento.key === 'Escape' && menuNavegacao.classList.contains('menu-aberto')) {
            fecharMenuMobile();
            btnMenuMobile.focus();
          }
        });

        // Fechar menu mobile automaticamente ao clicar em um link
        var linksMenu = menuNavegacao.querySelectorAll('a');
        linksMenu.forEach(function (link) {
          link.addEventListener('click', function () {
            if (menuNavegacao.classList.contains('menu-aberto')) {
              fecharMenuMobile();
            }
          });
        });
      }

      /* ======================================================================
         4. PERGUNTAS FREQUENTES (ACCORDION ACESSÍVEL)
         Controle via WAI-ARIA com suporte para navegação por teclado
         ====================================================================== */
      var botoesFaq = document.querySelectorAll('.faq-botao');

      botoesFaq.forEach(function (botao) {
        botao.addEventListener('click', function () {
          var expandido = botao.getAttribute('aria-expanded') === 'true';
          var painelId = botao.getAttribute('aria-controls');
          var painel = document.getElementById(painelId);

          if (!painel) return;

          if (expandido) {
            // Fechar o item atual
            botao.setAttribute('aria-expanded', 'false');
            painel.hidden = true;
          } else {
            // Abrir o item clicado
            botao.setAttribute('aria-expanded', 'true');
            painel.hidden = false;
            avisarLeitorTela('Pergunta expandida: ' + botao.textContent.trim());
          }
        });
      });

    });
  </script>
